# Harbor deployment settings. Copy to .env (`make init`), edit, then `make deploy`.
# `make setup` renders harbor.yml from this file and runs the official Harbor `prepare` tool,
# which generates docker-compose.yml and common/config/. Never edit those generated files.

# ---------------------------------------------------------------- site
# Public hostname of the registry (UI, API and `docker login`). Not localhost / 127.0.0.1.
HARBOR_HOSTNAME=harbor.example.com

# How Harbor is reached:
#   traefik     an existing Traefik terminates TLS; Harbor's nginx publishes no ports and joins TRAEFIK_NETWORK
#   standalone  Harbor's nginx publishes HTTP_PORT (and HTTPS_PORT when TLS_CERT/TLS_KEY are set)
PROXY_MODE=traefik

# ---------------------------------------------------------------- PROXY_MODE=traefik
TRAEFIK_NETWORK=traefik-net
TRAEFIK_ENTRYPOINT=websecure
# DNS alias of Harbor's nginx on TRAEFIK_NETWORK (target of the Traefik route: http://<alias>:8080).
TRAEFIK_ALIAS=harbor-proxy
# Optional: certresolver and comma-separated middlewares for the docker-provider labels,
# e.g. TRAEFIK_CERTRESOLVER=letsencrypt, TRAEFIK_MIDDLEWARES=security-headers-cdn@file
TRAEFIK_CERTRESOLVER=
TRAEFIK_MIDDLEWARES=

# ---------------------------------------------------------------- PROXY_MODE=standalone
# Address the published ports bind to (0.0.0.0 = all interfaces).
BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
# Host paths of the TLS certificate (full chain) and key. Empty = plain HTTP (testing only:
# docker clients refuse non-TLS registries other than localhost unless configured as insecure).
TLS_CERT=
TLS_KEY=
# URL clients actually use, when it differs from what the settings above imply, e.g.
# https://harbor.example.com when a separate proxy forwards to BIND_ADDRESS:HTTP_PORT.
# PROXY_MODE=traefik uses https://HARBOR_HOSTNAME unless this is set.
EXTERNAL_URL=

# ---------------------------------------------------------------- storage
# Harbor data (database, registry blobs, secrets). Relative paths are relative to this directory.
DATA_DIR=./data
# Component logs written by the harbor-log container.
LOG_DIR=./logs
LOG_LEVEL=info
LOG_ROTATE_COUNT=50
LOG_ROTATE_SIZE=200M

# ---------------------------------------------------------------- images
# Registry prefix for the goharbor/* images, with a trailing slash, e.g. registry.isatispooya.com/
# Empty = Docker Hub. The Harbor version is pinned in upstream/VERSION (`make update-upstream`).
HARBOR_IMAGE_REGISTRY=

# ---------------------------------------------------------------- features
# Trivy vulnerability scanner. Its DB is downloaded from TRIVY_DB_REPOSITORY (OCI) every 12h;
# point the repositories at a mirror, or set TRIVY_SKIP_UPDATE=1 on air-gapped hosts.
ENABLE_TRIVY=1
TRIVY_SKIP_UPDATE=0
TRIVY_DB_REPOSITORY=ghcr.io/aquasecurity/trivy-db
TRIVY_JAVA_DB_REPOSITORY=ghcr.io/aquasecurity/trivy-java-db

# Prometheus metrics on nginx :9090 (/metrics), published on METRICS_BIND:METRICS_PORT.
ENABLE_METRICS=0
METRICS_BIND=127.0.0.1
METRICS_PORT=9090

# Redis cache for manifests/artifacts (faster concurrent pulls).
ENABLE_CACHE=0

MAX_JOB_WORKERS=10

# Outbound HTTP proxy for core, jobservice and trivy (replication, proxy cache, Trivy DB).
HARBOR_HTTP_PROXY=
HARBOR_HTTPS_PROXY=
HARBOR_NO_PROXY=

# ---------------------------------------------------------------- secrets
# Generated by `make setup` when empty, then kept. HARBOR_ADMIN_PASSWORD is only applied on the
# very first start (change it in the UI afterwards); HARBOR_DB_PASSWORD must never change once
# the database exists. Both are in every backup.
HARBOR_ADMIN_PASSWORD=
HARBOR_DB_PASSWORD=

# ---------------------------------------------------------------- operations
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
# 1 = also archive the registry blobs (DATA_DIR/registry); can be very large.
BACKUP_REGISTRY=0
WAIT_TIMEOUT=300

COMPOSE_PROJECT_NAME=harbor
# Set by `make setup` from PROXY_MODE and the feature flags.
COMPOSE_FILE=
